# Copiez ce fichier vers .env et renseignez les clés de votre projet Supabase
# (Project Settings → API). .env est ignoré par git, jamais commité.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Clé Anthropic utilisée uniquement côté serveur (Edge Function), jamais ici.
# Voir supabase/functions/extract-recipe/ — ANTHROPIC_API_KEY est un secret
# Supabase (`supabase secrets set`), pas une variable VITE_*.
