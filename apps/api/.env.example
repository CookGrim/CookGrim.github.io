# Copiez vers .env. Sans TURSO_DATABASE_URL, l'API utilise un fichier
# SQLite local (./local.db) — pratique pour développer sans compte Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Génère une valeur avec: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173

# Secret côté serveur uniquement — jamais exposé au frontend.
ANTHROPIC_API_KEY=

PORT=8787
